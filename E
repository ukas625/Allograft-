def video_analysieren(video_pfad, intervall_sek, rois):
cap = cv2.VideoCapture(video_pfad)

```
if not cap.isOpened():
    print(f"❌ Video konnte nicht geöffnet werden: {video_pfad}")
    return None

fps = cap.get(cv2.CAP_PROP_FPS)
gesamt_frames = int(cap.get(cv2.CAP_PROP_FRAME_COUNT))
gesamt_sek = gesamt_frames / fps
frame_intervall = int(fps * intervall_sek)

print(f"📹 Video geladen: {os.path.basename(video_pfad)}")
print(f"   FPS: {fps:.1f} | Dauer: {timedelta(seconds=int(gesamt_sek))} | Frames: {gesamt_frames}")
print(f"   Analysiere jeden {intervall_sek}. Sekunde ({gesamt_sek / intervall_sek:.0f} Frames total)\n")

ergebnisse = []
frame_nr = 0

while True:
    ret, frame = cap.read()
    if not ret:
        break

    if frame_nr % frame_intervall == 0:
        zeitstempel = frame_nr / fps
        zeitstempel_str = str(timedelta(seconds=int(zeitstempel)))

        if rois:
            # Jede ROI einzeln auslesen
            zeile = {"zeitstempel_sek": round(zeitstempel, 2), "zeitstempel": zeitstempel_str}
            for name, roi in rois.items():
                zahlen = zahlen_extrahieren(frame, roi)
                zeile[name] = zahlen[0] if zahlen else None
            ergebnisse.append(zeile)
        else:
            # Ganzen Frame auslesen – alle gefundenen Zahlen
            zahlen = zahlen_extrahieren(frame)
            zeile = {
                "zeitstempel_sek": round(zeitstempel, 2),
                "zeitstempel": zeitstempel_str,
                "gefundene_zahlen": zahlen
            }
            ergebnisse.append(zeile)

        print(f"  ⏱ {zeitstempel_str} → {zeile}")

    frame_nr += 1

cap.release()

df = pd.DataFrame(ergebnisse)
return df
```

