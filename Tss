    'Cluster_KMeans', 'Cluster_DBSCAN'
]
export_cols = [c for c in export_cols if c in df.columns]
df_final = df[export_cols].copy()

# ── Lesbare Labels hinzufügen ─────────────────────────────────
df_final['Status'] = 'Normal'
df_final.loc[
    (df_final[VB_LAENGS + '_z'].abs() > 2) |
    (df_final[VB_QUER   + '_z'].abs() > 2),
    'Status'
] = '⚠ Z-Score Ausreißer'

df_final.loc[
    df_final['Cluster_DBSCAN'] == -1,
    'Status'
] = '🔴 DBSCAN Anomalie'

df_final.loc[
    df_final['Cluster_KMeans'] == 1,
    'Cluster_Bezeichnung'
] = 'Hochhaftung'
df_final.loc[
    df_final['Cluster_KMeans'] == 0,
    'Cluster_Bezeichnung'
] = 'Normalbetrieb'

# ── Statistiken ausgeben ──────────────────────────────────────
print(f"\n📊 Datenbasis: {len(df_final)} FAUFs")
print(f"\n🔵 K-Means Cluster:")
