cluster_features = [
    COL_ANFANG, 'Drift_Paste_imp', 'Drift_abs_imp', 'Hat_Satzende',
    COL_WECHSEL + '_enc', COL_FRISCH + '_enc',
    'Schaum_enc',
    VB_LAENGS, VB_QUER
]
cluster_features = [c for c in cluster_features if c in df.columns]

df_c      = df[cluster_features].dropna()
idx_valid = df_c.index

X        = StandardScaler().fit_transform(df_c)
pca      = PCA(n_components=2)
X_pca    = pca.fit_transform(X)
var_expl = pca.explained_variance_ratio_

print(f'Gültige FAUFs: {len(df_c)} von {len(df)}')
print(f'PCA: PC1={var_expl[0]:.1%}, PC2={var_expl[1]:.1%}, Gesamt={sum(var_expl):.1%}')
print(f'\nFeatures im Clustering:')
for f in cluster_features:
    print(f'  • {f}')














inertias, sil_scores = [], []
K_range = range(2, 9)

for k in K_range:
    km = KMeans(n_clusters=k, random_state=42, n_init=10)
    km.fit(X)
    inertias.append(km.inertia_)
    sil_scores.append(silhouette_score(X, km.labels_))

best_k = list(K_range)[np.argmax(sil_scores)]

fig, axes = plt.subplots(1, 2, figsize=(14, 5))

axes[0].plot(K_range, inertias, 'bo-', markersize=8)
axes[0].set_xlabel('Anzahl Cluster k')
axes[0].set_ylabel('Inertia')
axes[0].set_title('Elbow-Methode')
axes[0].grid(True, alpha=0.3)

axes[1].plot(K_range, sil_scores, 'rs-', markersize=8)
axes[1].axvline(best_k, color='green', linestyle='--',
                label=f'Optimales k={best_k}')
axes[1].set_xlabel('Anzahl Cluster k')
axes[1].set_ylabel('Silhouette Score')
axes[1].set_title('Silhouette Score (höher = besser)')
axes[1].legend()
axes[1].grid(True, alpha=0.3)

plt.tight_layout()
plt.show()
print(f'✅ Optimales k = {best_k}')









kmeans = KMeans(n_clusters=best_k, random_state=42, n_init=10)
df.loc[idx_valid, 'Cluster_KMeans'] = kmeans.fit_predict(X)

fig, ax = plt.subplots(figsize=(9, 6))
sc = ax.scatter(
    X_pca[:, 0], X_pca[:, 1],
    c=df.loc[idx_valid, 'Cluster_KMeans'],
    cmap='tab10', s=90, edgecolors='white', linewidth=0.6
)
ax.set_xlabel(f'PC1 ({var_expl[0]:.1%})')
ax.set_ylabel(f'PC2 ({var_expl[1]:.1%})')
ax.set_title(f'K-Means (k={best_k}) — PCA Projektion')
plt.colorbar(sc, label='Cluster')
plt.tight_layout()
plt.show()

print('Verbundhaftung + Prozessparameter je Cluster:')
display(
    df.groupby('Cluster_KMeans')[
        [VB_LAENGS, VB_QUER, COL_ANFANG, 'Drift_Paste_imp', 'Schaum_enc']
    ].agg(['mean', 'std']).round(2)
)









db = DBSCAN(eps=1.0, min_samples=3)
df.loc[idx_valid, 'Cluster_DBSCAN'] = db.fit_predict(X)
n_out = (df['Cluster_DBSCAN'] == -1).sum()

fig, ax = plt.subplots(figsize=(9, 6))
colors = ['red' if l == -1 else 'steelblue'
          for l in df.loc[idx_valid, 'Cluster_DBSCAN']]
ax.scatter(X_pca[:, 0], X_pca[:, 1], c=colors,
           s=90, edgecolors='white', linewidth=0.6)
ax.set_xlabel(f'PC1 ({var_expl[0]:.1%})')
ax.set_ylabel(f'PC2 ({var_expl[1]:.1%})')
ax.set_title(f'DBSCAN — {n_out} Ausreißer (rot)')

from matplotlib.patches import Patch
ax.legend(handles=[
    Patch(color='steelblue', label='Normal'),
    Patch(color='red', label=f'Ausreißer n={n_out}')
])
plt.tight_layout()
plt.show()

print(f'DBSCAN Ausreißer-FAUFs:')
display(
    df[df['Cluster_DBSCAN'] == -1][
        [COL_FAUF, COL_REZEPT, COL_SCHAUM,
         VB_LAENGS, VB_QUER, 'Drift_Paste_imp']
    ].reset_index(drop=True)
)
