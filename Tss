print(f"\n🏆 Top Einflussfaktoren auf Verbundhaftung:")
print(f"   1. Kaschierpastenauftrag Satzanfang")
print(f"      → Mehr Paste = bessere Haftung (quer: 0.65, längs: 0.35)")
print(f"   2. Schaumpastenrezeptur")
print(f"      → Rezeptauswahl hat systematischen Einfluss")
print(f"      → Besonders bei VB längs (0.33)")
print(f"   3. Walzentyp (nur VB längs: 0.15)")
print(f"   4. Drift Kaschierpaste (nur VB quer: 0.07)")

print(f"\n💡 Handlungsempfehlungen:")
print(f"   • Kaschierpastenauftrag möglichst konstant hoch halten")
