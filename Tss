                             scoring='neg_mean_absolute_error')

    imp     = pd.Series(rf.feature_importances_, index=rf_features)
    imp_top = imp.sort_values(ascending=False).head(10).sort_values()
    bar_colors = [color if v > imp_top.quantile(0.6)
                  else '#cccccc' for v in imp_top]

    ax.barh(imp_top.index, imp_top.values,
            color=bar_colors, edgecolor='white')
    ax.set_title(f'{target}\n'
                 f'R² CV: {cv_r2.mean():.3f} ± {cv_r2.std():.3f} | '
                 f'MAE: {-cv_mae.mean():.1f} N')
    ax.set_xlabel('Feature Importance')
    ax.grid(True, alpha=0.3, axis='x')

    print(f'\n{target}')
    print(f'  R²  (3-fold): {cv_r2.mean():.3f} ± {cv_r2.std():.3f}')
    print(f'  MAE (3-fold): {-cv_mae.mean():.1f} N')
    print(f'  Top 5:')
