df['Rezept_enc'] = LabelEncoder().fit_transform(
    df['Rezept_Gruppe'].fillna('Unbekannt'))
df['Walze_enc']  = LabelEncoder().fit_transform(
    df[COL_WALZE].fillna('Unbekannt'))

rf_features = [
    COL_ANFANG, 'Drift_Paste_imp', 'Drift_abs_imp', 'Hat_Satzende',
    COL_WECHSEL + '_enc',
    'Schaum_enc', 'Rezept_enc', 'Walze_enc'
]
rf_features = [c for c in rf_features if c in df.columns]

fig, axes = plt.subplots(1, 2, figsize=(16, 6))

for ax, target, color in zip(axes, [VB_LAENGS, VB_QUER],
                              ['steelblue', 'tomato']):
    mask = df[rf_features + [target]].dropna().index
    X_rf = df.loc[mask, rf_features]
    y_rf = df.loc[mask, target]

    # Weniger Tiefe + Leave-One-Out wegen kleinem Datensatz
    rf = RandomForestRegressor(
        n_estimators=300,
        max_depth=3,        # ← reduziert von 6 auf 3
        min_samples_leaf=5, # ← neu: mindestens 5 Samples pro Blatt
        random_state=42,
        n_jobs=-1
    )
    rf.fit(X_rf, y_rf)

    # 3-fold statt 5-fold wegen kleinem Datensatz
    cv_r2  = cross_val_score(rf, X_rf, y_rf, cv=3, scoring='r2')
    cv_mae = cross_val_score(rf, X_rf, y_rf, cv=3,
                             scoring='neg_mean_absolute_error')

    imp = pd.Series(rf.feature_importances_,
                    index=rf_features).sort_values()
    bar_colors = [color if v > imp.quantile(0.6) else '#cccccc'
                  for v in imp]
    ax.barh(imp.index, imp.values, color=bar_colors, edgecolor='white')
    ax.set_title(f'{target}\n'
                 f'R² CV: {cv_r2.mean():.3f} ± {cv_r2.std():.3f} | '
                 f'MAE: {-cv_mae.mean():.1f} N')
    ax.set_xlabel('Feature Importance')
    ax.grid(True, alpha=0.3, axis='x')

    print(f'\n{target}')
    print(f'  R² (3-fold CV):  {cv_r2.mean():.3f} ± {cv_r2.std():.3f}')
    print(f'  MAE (3-fold CV): {-cv_mae.mean():.1f} N')
    print(f'  Top 3 Features:')
    for feat, val in imp.sort_values(ascending=False).head(3).items():
        print(f'    {feat}: {val:.3f}')

plt.tight_layout()
plt.show()
