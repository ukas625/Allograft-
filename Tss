rf_features = [COL_ANFANG, COL_ENDE, 'Drift_Paste', 'Drift_abs',
               COL_WECHSEL + '_enc', COL_FRISCH + '_enc',
               'Rezept_enc', 'Walze_enc']

fig, axes = plt.subplots(1, 2, figsize=(16, 6))

for ax, target, color in zip(axes, [VB_LAENGS, VB_QUER], ['steelblue', 'tomato']):
    mask = df[rf_features + [target]].dropna().index
    X_rf, y_rf = df.loc[mask, rf_features], df.loc[mask, target]

    rf = RandomForestRegressor(n_estimators=300, max_depth=6, random_state=42)
    rf.fit(X_rf, y_rf)
    cv_r2 = cross_val_score(rf, X_rf, y_rf, cv=5, scoring='r2')

    imp = pd.Series(rf.feature_importances_, index=rf_features).sort_values()
