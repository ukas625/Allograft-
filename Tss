    X_rf = df.loc[mask, rf_features]
    y_rf = df.loc[mask, target]

    rf = RandomForestRegressor(
        n_estimators=300, max_depth=3,
        min_samples_leaf=5, random_state=42, n_jobs=-1
    )
    rf.fit(X_rf, y_rf)

