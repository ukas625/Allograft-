fig, axes = plt.subplots(2, 2, figsize=(18, 12))
fig.suptitle('Verbundhaftung Analyse — Gesamtübersicht',
             fontsize=16, fontweight='bold', y=1.01)

# ── Plot 1: Verteilung VB längs vs quer ───────────────────────
ax = axes[0, 0]
ax.scatter(
    df_final[VB_LAENGS], df_final[VB_QUER],
    c=df_final['Cluster_KMeans'].map({0: 'steelblue', 1: 'tomato'}),
    s=80, edgecolors='white', linewidth=0.6, alpha=0.85
)
# DBSCAN Anomalien markieren
anomalien = df_final[df_final['Cluster_DBSCAN'] == -1]
ax.scatter(
    anomalien[VB_LAENGS], anomalien[VB_QUER],
    s=150, facecolors='none', edgecolors='red',
    linewidth=2, label='DBSCAN Anomalie', zorder=5
)
ax.set_xlabel('Verbundhaftung / längs [N]')
ax.set_ylabel('Verbundhaftung / quer [N]')
ax.set_title('VB längs vs. quer\n(Farbe = K-Means Cluster, Kreis = Anomalie)')
ax.legend(handles=[
    Patch(color='steelblue', label='Cluster 0 — Normalbetrieb'),
    Patch(color='tomato',    label='Cluster 1 — Hochhaftung'),
    plt.Line2D([0], [0], marker='o', color='w',
               markerfacecolor='none', markeredgecolor='red',
               markersize=10, linewidth=2, label='DBSCAN Anomalie')
], fontsize=9)
ax.grid(True, alpha=0.3)

# ── Plot 2: Kaschierpaste vs VB quer (wichtigster Zusammenhang)
ax = axes[0, 1]
farben_cluster = df_final['Cluster_KMeans'].map(
    {0: 'steelblue', 1: 'tomato'})
ax.scatter(df_final[COL_ANFANG], df_final[VB_QUER],
           c=farben_cluster, s=80,
           edgecolors='white', linewidth=0.6, alpha=0.85)

# Regressionslinie
valid = df_final[[COL_ANFANG, VB_QUER]].dropna()
m, b, r, p, _ = stats.linregress(
    valid[COL_ANFANG].astype(float),
    valid[VB_QUER].astype(float)
)
x_line = np.linspace(valid[COL_ANFANG].min(),
                     valid[COL_ANFANG].max(), 100)
ax.plot(x_line, m * x_line + b, 'k--',
        linewidth=1.5, label=f'r={r:.2f}, p={p:.3f}')
ax.set_xlabel('Kaschierpastenauftrag Satzanfang [g/m²]')
ax.set_ylabel('Verbundhaftung / quer [N]')
ax.set_title('Wichtigster Zusammenhang\nKaschierpaste → VB quer')
ax.legend(fontsize=9)
ax.grid(True, alpha=0.3)

# ── Plot 3: VB längs nach Schaumpastenrezeptur ────────────────
ax = axes[1, 0]
if COL_SCHAUM in df_final.columns:
    schaum_gruppen = df_final.groupby(COL_SCHAUM)[VB_LAENGS].apply(list)
    schaum_gruppen = schaum_gruppen[
        schaum_gruppen.apply(len) >= 3  # mind. 3 FAUFs
    ].sort_index()

    bp = ax.boxplot(
        schaum_gruppen.values,
        labels=[str(s)[:15] for s in schaum_gruppen.index],
        patch_artist=True,
        medianprops=dict(color='white', linewidth=2)
    )
    colors_box = plt.cm.tab10(
        np.linspace(0, 1, len(schaum_gruppen)))
    for patch, color in zip(bp['boxes'], colors_box):
        patch.set_facecolor(color)

    ax.set_xlabel('Schaumpastenrezeptur')
    ax.set_ylabel('Verbundhaftung / längs [N]')
    ax.set_title('VB längs je Schaumpastenrezeptur\n'
                 '(bestätigt Einfluss der Schaumpaste)')
    ax.tick_params(axis='x', rotation=30)
    ax.grid(True, alpha=0.3, axis='y')

# ── Plot 4: Feature Importance Vergleich ─────────────────────
ax = axes[1, 1]
features_label = [
    'Kaschierpaste\nSatzanfang',
    'Schaum\nRezeptur',
    'Walze\nTyp',
    'Drift\nPaste',
    'Drift\nabs',
    'Rezept\nGruppe',
    'Hat\nSatzende',
    'Walze\ngewechselt'
]
# Werte aus Random Forest Ergebnis (manuell aus Ausgabe)
imp_laengs = [0.352, 0.333, 0.154, 0.067, 0.048, 0.030, 0.010, 0.006]
imp_quer   = [0.651, 0.169, 0.044, 0.067, 0.034, 0.020, 0.010, 0.005]

x = np.arange(len(features_label))
width = 0.35
ax.bar(x - width/2, imp_laengs, width,
       label='VB längs', color='steelblue', alpha=0.85)
ax.bar(x + width/2, imp_quer, width,
       label='VB quer', color='tomato', alpha=0.85)
ax.set_xticks(x)
ax.set_xticklabels(features_label, fontsize=8)
ax.set_ylabel('Feature Importance')
ax.set_title('Feature Importance — längs vs. quer\n'
             'Kaschierpaste + Schaum dominieren')
ax.legend()
ax.grid(True, alpha=0.3, axis='y')

plt.tight_layout()
plt.savefig('verbundhaftung_gesamtuebersicht.png',
            dpi=150, bbox_inches='tight')
plt.show()

